{
  "name": "yengconstantino-official",
  "version": "1.0.0",
  "description": "Yeng Constantino fan platform — spec concept by Global Media (web + iOS)",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'Static site - nothing to build'",
    "build:www": "node scripts/build-www.js",
    "patch:config": "node scripts/patch-cap-config.js",
    "cap:sync": "npm run build:www && npx cap sync ios && npm run patch:config",
    "cap:copy": "npm run build:www && npx cap copy ios && npm run patch:config",
    "cap:open": "npx cap open ios",
    "cap:run": "npx cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "airtable": "^0.12.2",
    "bcryptjs": "^2.4.3",
    "capacitor-native-biometric": "^4.2.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.52.0",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4"
  },
  "capacitor": {
    "appId": "com.globalmedia.yeng",
    "appName": "Yeng Constantino",
    "webDir": "www"
  }
}
